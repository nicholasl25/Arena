{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physics-sandbox.local/schemas/match_segment.schema.json",
  "title": "MatchSegment",
  "description": "Output of the Voice Over cell. Stitch consumes an ordered list of these.",
  "type": "object",
  "required": ["matchKey", "order", "status", "parts", "file"],
  "additionalProperties": true,
  "properties": {
    "matchKey": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "aName": { "type": ["string", "null"] },
    "bName": { "type": ["string", "null"] },
    "winnerName": { "type": ["string", "null"] },
    "file": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "building", "done", "error"] },
    "parts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["kind", "file"],
        "properties": {
          "kind": { "enum": ["bracket-pre", "arena", "bracket-post"] },
          "file": { "type": "string" }
        }
      }
    },
    "narration": { "type": "object" },
    "duration": { "type": "number" },
    "error": { "type": ["string", "null"] }
  }
}

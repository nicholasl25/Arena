{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physics-sandbox.local/schemas/bracket_state.schema.json",
  "title": "BracketState",
  "description": "Output of the Bracket cell / input to Arena + Voice Over. Single-elimination tournament tree.",
  "type": "object",
  "required": ["rounds", "fighters", "complete"],
  "additionalProperties": true,
  "properties": {
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": { "type": "object", "required": ["id"] }
      }
    },
    "fighters": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "object", "required": ["id", "name"] }
    },
    "complete": { "type": "boolean" },
    "champion": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["id", "name"] }
      ]
    },
    "size": { "type": "integer", "minimum": 2 }
  }
}
